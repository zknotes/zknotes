# ZKnotes API — Environment variables
# Copy to server/.env (local development) or docker/.env (the Docker stack, see docker/README.md)
# and fill in values — docker/setup.sh does that for the Docker stack, secrets included. Never commit
# .env to version control.
# All variables are required in production unless marked [optional].

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL.
# Local dev:  postgresql://zknotes:zknotes@localhost:5434/zknotes
# Production (docker/docker-compose.yml): leave this line alone — compose sets DATABASE_URL for the
# API container from POSTGRES_PASSWORD, and that value overrides this one.
DATABASE_URL=postgresql://zknotes:zknotes@localhost:5434/zknotes
# Production (docker/docker-compose.yml) only: the database password, used by the db service and
# in DATABASE_URL. Generate with: openssl rand -hex 32
# POSTGRES_PASSWORD=
# [optional] Database connection pool & timeout settings (defaults: max 20, statement timeout 15s, idle in tx 30s)
# PG_POOL_MAX=20
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# ── Object Storage (any S3-compatible provider) ───────────────────────────────
# Local dev: Garage at http://localhost:9000 (root docker-compose.yml).
# Production: the PUBLIC https:// origin of your object storage (e.g. https://s3.example.com) — the
# browser uploads and downloads through presigned URLs built from it, so it must be an address the
# browser can reach, never a Docker service name. Production refuses to start with a loopback or a
# plain http:// endpoint, or with the development keys below. Set it for AWS S3 too
# (https://s3.<region>.amazonaws.com): the web container injects this origin into the CSP
# connect-src (CSP_CONNECT_EXTRA), and without it presigned uploads/downloads are blocked.
# Keep the bucket private, and give the key s3:GetObject, s3:PutObject, s3:DeleteObject and
# s3:ListBucket on that bucket only (docker/README.md, "Object storage").
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zknotes
S3_ACCESS_KEY=minioadmin
# Garage refuses any secret shorter than 16 characters — this dev-only placeholder just clears that bar.
S3_SECRET_KEY=minioadmin-dev-secret
# [optional] Create S3_BUCKET at startup when it is missing. Always on in development; in production
# create the bucket (with a CORS rule for your app origin) with your storage provider instead.
# S3_AUTO_CREATE_BUCKET=1
#
# The built-in storage (docker/docker-compose.yml only; docker/setup.sh sets all of this):
# COMPOSE_PROFILES=storage starts a Garage node; STORAGE_DOMAIN is the domain Caddy serves it on
# (docker/sites/storage.caddy), and S3_ENDPOINT is then https://<STORAGE_DOMAIN>, S3_REGION
# us-east-1, and S3_ACCESS_KEY / S3_SECRET_KEY freshly generated (GK + 24 hex / 64 hex).
# GARAGE_RPC_SECRET is Garage's own secret (64 hex characters).
# COMPOSE_PROFILES=storage
# STORAGE_DOMAIN=s3.notes.example.com
# GARAGE_RPC_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Node environment: "development" or "production". Affects defaults, logging and the production
# guards (secrets, CORS_ORIGIN). A variable already set in the shell wins over this file:
# ./dev.sh runs the API with NODE_ENV=development, docker/docker-compose.yml with production.
NODE_ENV=production
PORT=3000
# [optional] The address the API listens on. Default 127.0.0.1; docker/docker-compose.yml sets 0.0.0.0
# so Caddy can reach it from its container.
# HOST=127.0.0.1
# Not set here: APP_COMMIT comes from the Docker build (docker/README.md, §2); APP_VERSION is only a
# fallback for a layout without the root package.json, which is where the version is read from; and
# RATE_LIMIT_IN_TEST belongs to the test suite.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must match your deployed frontend URL.
# In production the API is same-origin with the SPA (Caddy path routing on
# the vault domain, see docker/Caddyfile) so this is effectively a no-op safety net.
# Required in production (startup throws if unset).
CORS_ORIGIN=https://notes.example.com

# ── Reverse proxy / client IP (rate-limit + session IP) ───────────────────────
# The IPs/CIDRs of the proxies whose X-Forwarded-For the API believes. Only a peer
# whose own address is listed can set the client address; everyone else gets
# their socket address. Without it behind a proxy, all clients share the proxy's
# address → one global rate-limit bucket (a login DoS for everyone).
# docker/docker-compose.yml defaults to its `edge` network (EDGE_SUBNET), which only
# Caddy shares with the API — set this only for a different proxy setup.
# Refused at startup: a hop count ("1"), which cannot check who the peer is, and
# "true" in production, which trusts every peer.
# TRUST_PROXY=172.30.250.0/24
# The subnet of that `edge` network; change it if it clashes with one on your host.
# EDGE_SUBNET=172.30.250.0/24
# Resolvers for the api and caddy containers (docker-compose.yml explains why).
# DNS_RESOLVER_1=1.1.1.1
# DNS_RESOLVER_2=9.9.9.9

# ── Cookie ────────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
# In production the server refuses to start while this is unset, the placeholder, or shorter
# than 32 characters.
COOKIE_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ── KDF (Argon2id — server-side verification of Auth Key hash) ────────────────
# 64 MiB memory
ARGON2_MEMORY_COST=65536
# 3 iterations
ARGON2_TIME_COST=3
# 4 parallelism
ARGON2_PARALLELISM=4

# Anti-enumeration: the seed of the deterministic fake KDF salt returned for unknown emails.
# CRITICAL: Generate ONCE and NEVER rotate. A new seed changes every fake salt, so anyone who
# saved one could tell a nonexistent account (its salt changed) from a real one (it did not).
#   Generate with: openssl rand -hex 32
# In production the server refuses to start while this is unset, the placeholder, or shorter
# than 32 characters.
KDF_FAKE_SEED=REPLACE_WITH_32_BYTE_HEX_STRING

# Minimum response time (milliseconds) of the sign-in, KDF-parameter, registration and
# credential-check routes, so their timing does not tell an existing account from a missing one.
MIN_AUTH_RESPONSE_MS=200

# [optional] Additional random delay in milliseconds (0..AUTH_JITTER_MS) added to auth responses.
# Helps make timing analysis harder while keeping MIN_AUTH_RESPONSE_MS as the baseline floor.
# Default is 50 when unset. Set to 0 only for local profiling / tests.
# AUTH_JITTER_MS=50

# ── Sign-in throttling ────────────────────────────────────────────────────────
# [optional] Failed sign-ins per account and source (an IPv4 address or an IPv6 /64): this
# many inside the window pause that source, for the base delay doubling up to the max.
# USER_LOGIN_MAX_ATTEMPTS=5
# USER_LOGIN_LOCKOUT_BASE_SECONDS=30
# USER_LOGIN_LOCKOUT_MAX_SECONDS=900
# USER_LOGIN_FAIL_WINDOW_SECONDS=3600
# [optional] The account-wide backstop across every source. It pauses the owner as well, so it
# sits far above what one source can reach on its own.
# USER_LOGIN_ACCOUNT_MAX_ATTEMPTS=100
# USER_LOGIN_ACCOUNT_LOCKOUT_BASE_SECONDS=900
# USER_LOGIN_ACCOUNT_LOCKOUT_MAX_SECONDS=3600
# USER_LOGIN_ACCOUNT_FAIL_WINDOW_SECONDS=3600

# [optional] Max concurrent Argon2 hash/verify ops (default 4). Caps RAM under login floods.
# ARGON2_MAX_CONCURRENT=4
# [optional] How many more may queue for a slot (default 32); past that a sign-in is refused at once
# instead of waiting.
# ARGON2_MAX_WAITERS=32

# [optional] Per-IP rate limits of the auth routes, per window (default 15 minutes): the
# unauthenticated ones (sign-in, KDF parameters, registration status, sign-out), vault creation, and
# the signed-in routes that check a credential again (password change, account deletion).
# AUTH_RATELIMIT_WINDOW="15 minutes"
# AUTH_LOGIN_RATELIMIT_MAX=10
# AUTH_REGISTER_RATELIMIT_MAX=5
# AUTH_SENSITIVE_RATELIMIT_MAX=10

# [optional] Authenticated mutation IP rate-limit (items/history/storage). Default 600/min.
# The outer layer: onRequest, keyed by IP. Do not lower it — NAT/CGNAT shares this bucket.
# AUTHENTICATED_MUTATION_RATELIMIT_MAX=600
# AUTHENTICATED_MUTATION_RATELIMIT_WINDOW="1 minute"
# The inner layer: preHandler, keyed by user_id (falling back to the IP). The same figure, a separate
# bucket per route.
# AUTHENTICATED_MUTATION_USER_RATELIMIT_MAX=600
# The read layer for the authenticated GETs that had no limit until now (GET /items and GET /auth/me,
# for instance). IP 600 = the outer guard; user 120 = the per-account ceiling. Chunk GET/HEAD stay on
# UPLOAD_CHUNK_*.
# AUTHENTICATED_READ_IP_RATELIMIT_MAX=600
# AUTHENTICATED_READ_USER_RATELIMIT_MAX=120
# AUTHENTICATED_READ_RATELIMIT_WINDOW="1 minute"
# [optional] POST /items/batch, per IP (default 600 per minute).
# ITEMS_BATCH_RATELIMIT_WINDOW="1 minute"
# ITEMS_BATCH_RATE_LIMIT_MAX=600
# [optional] File uploads: opening an upload, and the chunk requests (default 60 and 10000 per minute).
# UPLOAD_RATELIMIT_WINDOW="1 minute"
# UPLOAD_OPEN_RATE_LIMIT_MAX=60
# UPLOAD_CHUNK_RATE_LIMIT_MAX=10000
# [optional] POST /client-error, the browser's error reports: rate limit, body limit in bytes, and
# the length a message is cut to.
# CLIENT_ERROR_RATELIMIT_WINDOW="1 minute"
# CLIENT_ERROR_RATELIMIT_MAX=30
# CLIENT_ERROR_BODY_LIMIT=16384
# CLIENT_ERROR_MAX_LEN=1000

# [optional] Per-share password lockout (same idea as user login backoff).
# SHARE_PASSWORD_MAX_ATTEMPTS=5
# SHARE_PASSWORD_LOCKOUT_BASE_SECONDS=30
# SHARE_PASSWORD_LOCKOUT_MAX_SECONDS=900
# Failures count only inside this window from the first one (default: the max lockout above).
# SHARE_PASSWORD_FAIL_WINDOW_SECONDS=900

# [optional] Session duration in seconds (default 2592000 = 30 days)
# SESSION_TTL_SECONDS=2592000

# [optional] Public GET /health: per-IP rate limit, and how long the database probe is cached (ms).
# HEALTH_RATELIMIT_MAX=60
# HEALTH_RATELIMIT_WINDOW="1 minute"
# HEALTH_DB_CACHE_MS=5000

# ── Caddy (docker/docker-compose.yml only) ────────────────────────────────────
# The vault's domain. Caddy serves it and obtains its TLS certificate; it must point at the server.
# APP_DOMAIN=notes.example.com

# ── Registration (self-host) ──────────────────────────────────────────────────
# Creating a vault is POST /vault, and the keys are derived in the BROWSER — the server never
# sees the password, so it can neither create an account for you nor seed a demo one.
#
# Bootstrap: while the database holds no user, the route is open, so the first person to reach
# https://<your domain>/create-vault gets the vault. After that it closes with 403
# registration_closed, and the login page stops offering "Create one".
#
# Set this to true to keep it open for more accounts (family, team). Anyone who can reach the
# instance can then open a vault, so put it behind a firewall/VPN or flip it back off when done.
# SELF_HOST_REGISTRATION_OPEN=true

# ── What a new self-host account gets ─────────────────────────────────────────
# There is no plan here, so these are simply the numbers whoever hosts decides to give. They are
# written into the `users` row when the vault is created — changing them later does NOT move an
# account that already exists (see below).
#
# [optional] Total storage per account, in bytes. It counts the encrypted size of
# everything the account keeps — file chunks in the bucket (trashed files included), notes and their
# history in PostgreSQL — and is enforced with headroom: refused past 1.2 x the quota, and past 2 x
# for the files a restore from backup stages. Size the storage behind S3_BUCKET for at least twice
# the sum of the quotas you give out (docker/README.md, "Storage quota and disk"). Default 100 GiB.
# SELF_HOST_STORAGE_QUOTA=107374182400
#
# [optional] Largest single file, in bytes. The default is the largest a file can be at all —
# 12 GiB of plaintext, where the chunked (multipart) upload format stops — so by default nothing
# artificial limits one file, only the quota above and the disk. Set this only to impose a SMALLER
# ceiling; a larger number is clamped back to 12 GiB, because POST /uploads would refuse it anyway.
# SELF_HOST_MAX_FILE_SIZE=2147483648
#
# [optional] Active share links per account (default 10000), and the longest a link may live, in
# seconds (default 365 days).
# SELF_HOST_MAX_ACTIVE_SHARES=10000
# SELF_HOST_MAX_SHARE_TTL_SEC=31536000
#
# [optional] Ceilings on items per account (notes + folders + files, trash included; default 100000)
# and on live files (default 50000). They are not written into the account row, so a change applies
# to every account at once. The defaults are also what the client and the backup format expect: use
# these to lower the ceilings, not to raise them.
# MAX_ITEMS_COUNT=100000
# MAX_FILE_COUNT=50000
#
# To move an account that already exists (these values seed the row, they do not govern it):
#   docker compose exec db psql -U zknotes -d zknotes \
#     -c "UPDATE users SET max_file_size = 12884901888, storage_quota = 107374182400;"

# ── Public website / account origin (GET /instance-config) ────────────────────
# Runtime values for the vault client — not baked into the JS bundle. https:// only in production.
# Leave any of them unset and the client simply does not show that link.
#
# Corresponding Source for what THIS instance serves (AGPL-3.0 §13). The app links to it, with the
# licence, from the sign-in, account-creation and shared-note pages and Settings → About. Upstream is
# right for an unmodified install only: if you modify the client or the server, publish your version
# and point this at it instead — that is what the licence asks of you.
SOURCE_URL=https://github.com/zknotes/zknotes
#
# Optional links to the operator's own website and account page; leave unset to hide them.
# PUBLIC_WWW_URL=https://www.example.com
# ACCOUNT_MANAGE_URL=https://www.example.com/account

# ── GC (Garbage Collector for orphan chunk sets) ─────────────────────────────
# [optional] Set to "1" to disable GC (multi-node: only one node should run GC)
# GC_DISABLED=1
# [optional] Grace window between pending_delete mark and physical blob deletion (default 3600s = 1h)
# BLOB_PURGE_GRACE_SECONDS=3600
# [optional] Stale upload session threshold (default 86400s = 24h)
# GC_STALE_UPLOAD_SECONDS=86400
# [optional] GC run interval in ms (default 900000 = 15min)
# GC_INTERVAL_MS=900000
# [optional] Deep-repair scan interval in ms (default 604800000 = 7 days)
# GC_DEEP_INTERVAL_MS=604800000
# [optional] Min. age of a committed chunk_set with no item row before it is marked an orphan in runGc (default 86400 = 24h)
# GC_ORPHAN_CHUNK_SET_MIN_AGE_SECONDS=86400
# [optional] Days an item stays in the Trash before it is deleted for good (default 30). The app's
# Trash shows a countdown that assumes 30, so a different value makes that countdown wrong.
# TRASH_RETENTION_DAYS=30
# [optional] Days a purged_at tombstone stays in items before physical delete (default 30).
# Safe to keep short — the durable deletion signal lives in sync_deleted_log.
# TOMBSTONE_PURGE_DAYS=30
# [optional] Days sync_deleted_log entries are retained (default 730 = 2 years).
# Clients with a sync watermark older than this must do a full re-bootstrap.
# SYNC_DELETED_LOG_RETENTION_DAYS=730
# [optional] Delta-pull watermark lag in ms (default 30000). Issued `server_time` is
# Date.now() minus this window so a long batch transaction that stamped `updated_at`
# before commit still appears in the next pull. Not a proof:
# a transaction longer than this window can still be skipped. Set 0 only to roll back.
# SYNC_WATERMARK_SAFETY_MS=30000
# [optional] Days inactive share_links rows are retained after revoke/expiry (default 90)
# SHARE_ROW_RETENTION_DAYS=90

# ── Share links ───────────────────────────────────────────────────────────────
# SHARE_RATELIMIT_WINDOW="1 minute"
# SHARE_CREATE_RATE_LIMIT_MAX=30
# SHARE_META_RATE_LIMIT_MAX=60
# SHARE_VIEW_RATE_LIMIT_MAX=10
# SHARE_CHUNK_RATE_LIMIT_MAX=120
# [optional] Seconds attachments of a burned one-time link stay downloadable after the
# single view (recipient needs time to save files; owner revoke/expiry never opens this).
# SHARE_BURN_DOWNLOAD_GRACE_SEC=900

# ── Server-side analytics ─────────────────────────────────────────────────────
# The server keeps usage counts for the operator. None of it includes note content, IP addresses or
# user agents:
#   analytics_daily_active_users   (day, user id) for each day an account made a signed-in
#                                  request — kept ANALYTICS_DAU_RETENTION_DAYS (38)
#   analytics_active_users_daily   daily/monthly active and total account counts
#   analytics_route_daily          requests, status class and latency per route template and day
#   analytics_auth_daily           registrations and sign-in successes/failures per day
#   analytics_storage_quota_daily  accounts and storage use per quota size, per day
#                                  (the aggregates are kept ANALYTICS_AGGREGATE_RETENTION_DAYS, 730)
# users.last_seen_at (refreshed at most every 5 minutes) is account data, not analytics; it stays.
# [optional] 1 turns collection off entirely; rows collected earlier still expire on schedule.
# ANALYTICS_DISABLED=0
# [optional] ANALYTICS_FLUSH_INTERVAL_MS=60000
# [optional] ANALYTICS_DAU_RETENTION_DAYS=38
# [optional] ANALYTICS_AGGREGATE_RETENTION_DAYS=730
# [optional] Below this many accounts in a quota size, no percentiles are stored.
# ANALYTICS_STORAGE_TIER_MIN_SAMPLE=10
# [optional] When the daily rollup may run (UTC).
# ANALYTICS_DAILY_JOB_UTC_HOUR=0
# ANALYTICS_DAILY_JOB_UTC_MINUTE=15

# ── Logging ───────────────────────────────────────────────────────────────────
# [optional] Pino log level: trace | debug | info | warn | error | fatal
# Default: "info". Per-request lines are written at debug, so set debug to see them.
# In dev the level can be changed at runtime without restart:
#   curl -X PUT localhost:3000/dev-log-level -H 'content-type: application/json' -d '{"level":"debug"}'
# Per-request logging (method/url/status/duration) is emitted at debug level.
LOG_LEVEL=info

# [optional] Dev-only: file where stdout/stderr is mirrored (default "debug.log").
# Cleared via DELETE /dev-logs (DevPanel "Clear" button).
# DEV_LOG_FILE=debug.log
